            "output": "<path>/tmp/opencode/entireio-cli/cmd/entire/cli/agent/agent.go</path>\n<type>file</type>\n<content>\n1: // Package agent provides interfaces and types for integrating with coding agents.\n2: // It abstracts agent-specific behavior (hooks, log parsing, session storage) so that\n3: // the same Strategy implementations can work with any coding agent.\n4: package agent\n5: \n6: import (\n7: \t\"context\"\n8: \t\"io\"\n9: \t\"os/exec\"\n10: \n11: \t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n12: )\n13: \n14: // Agent defines the interface for interacting with a coding agent.\n15: // Each agent implementation (Claude Code, Cursor, Aider, etc.) converts its\n16: // native format to the normalized types defined in this package.\n17: //\n18: // The interface is organized into three groups:\n19: //   - Identity (5 methods): Name, Type, Description, DetectPresence, ProtectedDirs\n20: //   - Transcript Storage (3 methods): ReadTranscript, ChunkTranscript, ReassembleTranscript\n21: //   - Legacy (6 methods): Will be moved to optional interfaces or removed in a future phase\n22: type Agent interface {\n23: \t// --- Identity ---\n24: \n25: \t// Name returns the agent registry key (e.g., \"claude-code\", \"gemini\")\n26: \tName() types.AgentName\n27: \n28: \t// Type returns the agent type identifier (e.g., \"Claude Code\", \"Gemini CLI\")\n29: \t// This is stored in metadata and trailers.\n30: \tType() types.AgentType\n31: \n32: \t// Description returns a human-readable description for UI\n33: \tDescription() string\n34: \n35: \t// IsPreview returns whether the agent integration is in preview or stable\n36: \tIsPreview() bool\n37: \n38: \t// DetectPresence checks if this agent is configured in the repository\n39: \tDetectPresence(ctx context.Context) (bool, error)\n40: \n41: \t// ProtectedDirs returns repo-root-relative directories that should never be\n42: \t// modified or deleted during rewind or other destructive operations.\n43: \t// Examples: [\".claude\"] for Claude, [\".gemini\"] for Gemini.\n44: \tProtectedDirs() []string\n45: \n46: \t// --- Transcript Storage ---\n47: \n48: \t// ReadTranscript reads the raw transcript bytes for a session.\n49: \tReadTranscript(sessionRef string) ([]byte, error)\n50: \n51: \t// ChunkTranscript splits a transcript into chunks if it exceeds maxSize.\n52: \t// Returns a slice of chunks. If the transcript fits in one chunk, returns single-element slice.\n53: \t// The chunking is format-aware: JSONL splits at line boundaries, JSON splits message arrays.\n54: \tChunkTranscript(ctx context.Context, content []byte, maxSize int) ([][]byte, error)\n55: \n56: \t// ReassembleTranscript combines chunks back into a single transcript.\n57: \t// Handles format-specific reassembly (JSONL concatenation, JSON message merging).\n58: \tReassembleTranscript(chunks [][]byte) ([]byte, error)\n59: \n60: \t// --- Legacy methods (will move to optional interfaces in Phase 4) ---\n61: \n62: \t// GetSessionID extracts session ID from hook input.\n63: \tGetSessionID(input *HookInput) string\n64: \n65: \t// GetSessionDir returns where agent stores session data for this repo.\n66: \tGetSessionDir(repoPath string) (string, error)\n67: \n68: \t// ResolveSessionFile returns the path to the session transcript file.\n69: \t//\n70: \t// SECURITY CONTRACT: agentSessionID is used to build a filesystem path and\n71: \t// some implementations use it as a directory component or (Codex/Pi) return\n72: \t// it verbatim when absolute. Callers that source agentSessionID from\n73: \t// untrusted data (e.g. checkpoint metadata on the shared\n74: \t// entire/checkpoints/v1 branch, hook input) MUST validate it with\n75: \t// validation.ValidateSessionID first. The resume/rewind restore paths do\n76: \t// this at their choke points (transcript.resolveTranscriptPath and\n77: \t// strategy.RestoreLogsOnly); do not call this with unvalidated input.\n78: \tResolveSessionFile(sessionDir, agentSessionID string) string\n79: \n80: \t// ReadSession reads session data from agent's storage.\n81: \tReadSession(input *HookInput) (*AgentSession, error)\n82: \n83: \t// WriteSession writes session data for resumption.\n84: \tWriteSession(ctx context.Context, session *AgentSession) error\n85: \n86: \t// FormatResumeCommand returns command to resume a session.\n87: \tFormatResumeCommand(sessionID string) string\n88: }\n89: \n90: // HookSupport is implemented by agents with lifecycle hooks.\n91: // This optional interface allows agents like Claude Code and Cursor to\n92: // install and manage hooks that notify Entire of agent events.\n93: //\n94: // The interface is organized into two groups:\n95: //   - Hook Mapping (2 methods): HookNames, ParseHookEvent\n96: //   - Hook Management (3 methods): InstallHooks, UninstallHooks, AreHooksInstalled\n97: type HookSupport interface {\n98: \tAgent\n99: \n100: \t// HookNames returns the hook verbs this agent supports.\n101: \t// These become subcommands under `entire hooks <agent>`.\n102: \t// e.g., [\"stop\", \"user-prompt-submit\", \"session-start\", \"session-end\"]\n103: \tHookNames() []string\n104: \n105: \t// ParseHookEvent translates an agent-native hook into a normalized lifecycle Event.\n106: \t// Returns nil if the hook has no lifecycle significance (e.g., pass-through hooks).\n107: \t// This is the core contribution surface for new agent implementations.\n108: \tParseHookEvent(ctx context.Context, hookName string, stdin io.Reader) (*Event, error)\n109: \n110: \t// InstallHooks installs agent-specific hooks.\n111: \t// If localDev is true, hooks point to local development build.\n112: \t// If force is true, removes existing Entire hooks before installing.\n113: \t// Returns the number of hooks installed.\n114: \tInstallHooks(ctx context.Context, localDev bool, force bool) (int, error)\n115: \n116: \t// UninstallHooks removes installed hooks\n117: \tUninstallHooks(ctx context.Context) error\n118: \n119: \t// AreHooksInstalled checks if hooks are currently installed\n120: \tAreHooksInstalled(ctx context.Context) bool\n121: }\n122: \n123: // FileWatcher is implemented by agents that use file-based detection.\n124: // Agents like Aider that don't support hooks can use file watching\n125: // to detect session activity.\n126: type FileWatcher interface {\n127: \tAgent\n128: \n129: \t// GetWatchPaths returns paths to watch for session changes\n130: \tGetWatchPaths() ([]string, error)\n131: \n132: \t// OnFileChange handles a detected file change and returns session info\n133: \tOnFileChange(path string) (*SessionChange, error)\n134: }\n135: \n136: // ProtectedFilesProvider is implemented by agents that need to exclude\n137: // repo-root-relative files owned by the agent integration itself from session\n138: // tracking or destructive operations.\n139: type ProtectedFilesProvider interface {\n140: \tAgent\n141: \n142: \t// ProtectedFiles returns repo-root-relative files that belong to the\n143: \t// agent's own config/state and should be excluded from tracking.\n144: \tProtectedFiles() []string\n145: }\n146: \n147: // TranscriptAnalyzer provides format-specific transcript parsing.\n148: // Agents that implement this get richer checkpoints (transcript-derived file lists,\n149: // prompts, summaries). Agents that don't still participate in the checkpoint lifecycle\n150: // via git-status-based file detection and raw transcript storage.\n151: type TranscriptAnalyzer interface {\n152: \tAgent\n153: \n154: \t// GetTranscriptPosition returns the current position (length) of a transcript.\n155: \t// For JSONL formats (Claude Code), this is the line count.\n156: \t// For JSON formats (Gemini CLI), this is the message count.\n157: \t// Returns 0 if the file doesn't exist or is empty.\n158: \tGetTranscriptPosition(path string) (int, error)\n159: \n160: \t// ExtractModifiedFilesFromOffset extracts files modified since a given offset.\n161: \t// For JSONL formats (Claude Code), offset is the starting line number.\n162: \t// For JSON formats (Gemini CLI), offset is the starting message index.\n163: \t// Returns:\n164: \t//   - files: list of file paths modified by the agent (from Write/Edit tools)\n165: \t//   - currentPosition: the current position (line count or message count)\n166: \t//   - error: any error encountered during reading\n167: \tExtractModifiedFilesFromOffset(path string, startOffset int) (files []string, currentPosition int, err error)\n168: }\n169: \n170: // PromptExtractor extracts user prompts from a transcript file.\n171: // Used as a fallback when prompt data isn't captured via hooks (e.g., Factory AI\n172: // Droid's exec mode doesn't fire UserPromptSubmit).\n173: type PromptExtractor interface {\n174: \tAgent\n175: \n176: \t// ExtractPrompts returns user prompts from the transcript starting at the given offset.\n177: \tExtractPrompts(sessionRef string, fromOffset int) ([]string, error)\n178: }\n179: \n180: // TranscriptPreparer is called before ReadTranscript to handle agent-specific\n181: // flush/sync requirements (e.g., Claude Code's async transcript writing).\n182: // The framework calls PrepareTranscript before ReadTranscript if implemented.\n183: type TranscriptPreparer interface {\n184: \tAgent\n185: \n186: \t// PrepareTranscript ensures the transcript is ready to read.\n187: \t// For Claude Code, this waits for the async transcript flush to complete.\n188: \tPrepareTranscript(ctx context.Context, sessionRef string) error\n189: }\n190: \n191: // SidecarImageProvider is implemented by agents that keep images OUTSIDE the\n192: // transcript Entire condenses — e.g. Cursor stores pasted images in a per-session\n193: // SQLite blob store, not the JSONL transcript. The strategy layer calls this\n194: // during condensation/finalize to capture those images as checkpoint assets so\n195: // they're preserved with the session. Best-effort: returns nil (no error) when\n196: // the sidecar store is unavailable or unreadable.\n197: type SidecarImageProvider interface {\n198: \tAgent\n199: \n200: \t// SidecarImages returns images stored outside the transcript for the session\n201: \t// identified by sessionRef (the transcript path).\n202: \tSidecarImages(ctx context.Context, sessionRef string) ([]CompactedTranscriptAsset, error)\n203: }\n204: \n205: // TokenCalculator provides token usage calculation for a session.\n206: // The framework calls this during step save and checkpoint if implemented.\n207: type TokenCalculator interface {\n208: \tAgent\n209: \n210: \t// CalculateTokenUsage computes token usage from the transcript starting at the given offset.\n211: \tCalculateTokenUsage(transcriptData []byte, fromOffset int) (*TokenUsage, error)\n212: }\n213: \n214: // ModelExtractor extracts the LLM model identifier from a transcript for agents\n215: // that do not report the model through lifecycle hooks. Pi, for example, records\n216: // the model on every assistant message (message.model) but its hook events carry\n217: // no model field, so the transcript is the only source. The framework calls this\n218: // during condensation to backfill session state when the model is otherwise\n219: // unknown.\n220: type ModelExtractor interface {\n221: \tAgent\n222: \n223: \t// ExtractModel returns the model identifier from the transcript (e.g.\n224: \t// \"gpt-5.5\"), or \"\" if none can be determined.\n225: \tExtractModel(transcriptData []byte) (string, error)\n226: }\n227: \n228: // TextGenerator is an optional interface for agents whose CLI supports\n229: // non-interactive text generation (e.g., claude --print).\n230: // Used for AI-powered metadata generation (trail titles, summaries).\n231: type TextGenerator interface {\n232: \tAgent\n233: \n234: \t// GenerateText sends a prompt to the agent's CLI and returns the raw text response.\n235: \t// model is a hint (e.g., \"haiku\", \"sonnet\"). Implementations may ignore if not applicable.\n236: \tGenerateText(ctx context.Context, prompt string, model string) (string, error)\n237: }\n238: \n239: // ProgressPhase identifies a coarse stage in streaming text generation.\n240: type ProgressPhase string\n241: \n242: const (\n243: \t// PhaseConnecting is emitted once when the CLI signals it is making the upstream request.\n244: \tPhaseConnecting ProgressPhase = \"connecting\"\n245: \t// PhaseFirstToken is emitted once when the upstream responds with the first event,\n246: \t// carrying TTFT and input/cache token counts.\n247: \tPhaseFirstToken ProgressPhase = \"first-token\"\n248: \t// PhaseGenerating is emitted repeatedly as text or thinking deltas arrive.\n249: \t// OutputTokens carries a running estimate based on delta sizes.\n250: \tPhaseGenerating ProgressPhase = \"generating\"\n251: \t// PhaseDone is emitted once when the final result event is received without error.\n252: \tPhaseDone ProgressPhase = \"done\"\n253: )\n254: \n255: // GenerationProgress reports a snapshot of streaming text generation progress.\n256: // Fields not relevant to the current Phase may be zero-valued.\n257: type GenerationProgress struct {\n258: \tPhase             ProgressPhase\n259: \tOutputTokens      int // running estimate during PhaseGenerating; final at PhaseDone\n260: \tInputTokens       int // populated at PhaseFirstToken\n261: \tCachedInputTokens int // populated at PhaseFirstToken\n262: \tTTFTms            int // time-to-first-token, populated at PhaseFirstToken\n263: \tDurationMs        int // populated at PhaseDone (final result event)\n264: }\n265: \n266: // ProgressFn receives streaming progress updates. It must not block — invoke it\n267: // from the same goroutine that reads the stream and keep handlers fast.\n268: type ProgressFn func(GenerationProgress)\n269: \n270: // StreamingTextGenerator is an optional interface for text generators whose\n271: // underlying CLI exposes a streaming output mode. Callers can use AsStreamingTextGenerator\n272: // to detect support and fall back to plain GenerateText when unavailable.\n273: type StreamingTextGenerator interface {\n274: \tAgent\n275: \n276: \t// GenerateTextStreaming invokes the agent's streaming text generation and\n277: \t// calls progress for each phase update. progress may be nil to suppress\n278: \t// reporting. The returned string is the final response text.\n279: \tGenerateTextStreaming(ctx context.Context, prompt, model string, progress ProgressFn) (string, error)\n280: }\n281: \n282: // CompactedTranscript contains the result of transcript compaction into Entire\n283: // Transcript Format. Assets are accepted in the protocol shape for forward\n284: // compatibility but may not yet be persisted by all call sites.\n285: type CompactedTranscript struct {\n286: \tTranscript []byte\n287: \tAssets     []CompactedTranscriptAsset\n288: }\n289: \n290: // CompactedTranscriptAsset is binary data extracted during transcript compaction.\n291: type CompactedTranscriptAsset struct {\n292: \tName      string\n293: \tMediaType string\n294: \tData      []byte\n295: }\n296: \n297: // TranscriptCompactor is implemented by agents that can produce Entire\n298: // Transcript Format directly from their native transcript representation.\n299: type TranscriptCompactor interface {\n300: \tAgent\n301: \n302: \t// CompactTranscript converts the transcript referenced by sessionRef into\n303: \t// Entire Transcript Format and returns the compact transcript bytes.\n304: \tCompactTranscript(ctx context.Context, sessionRef string) (*CompactedTranscript, error)\n305: }\n306: \n307: // HookResponseWriter is implemented by agents that support structured hook responses.\n308: // Agents that implement this can output messages (e.g., banners) to the user via\n309: // the agent's response protocol. For example, Claude Code outputs JSON with a\n310: // systemMessage field to stdout. Agents that don't implement this will silently\n311: // skip hook response output.\n312: type HookResponseWriter interface {\n313: \tAgent\n314: \n315: \t// WriteHookResponse outputs a message to the user via the agent's hook response protocol.\n316: \tWriteHookResponse(message string) error\n317: }\n318: \n319: // RestoredSessionPathResolver is implemented by agents that need a\n320: // transcript-specific path when Entire reconstructs a session from checkpoint\n321: // metadata. This is used for restored sessions only; live sessions still use\n322: // the agent's native hook/session references.\n323: type RestoredSessionPathResolver interface {\n324: \tAgent\n325: \n326: \t// ResolveRestoredSessionFile returns where Entire should write a restored\n327: \t// transcript so the agent can discover it later.\n328: \tResolveRestoredSessionFile(sessionDir, agentSessionID string, transcript []byte) (string, error)\n329: }\n330: \n331: // TestOnly is implemented by agents that exist solely for testing (e.g., the Vogon canary agent).\n332: // These agents are excluded from the user-facing agent selection in `entire enable`.\n333: type TestOnly interface {\n334: \tAgent\n335: \tIsTestOnly() bool\n336: }\n337: \n338: // Launcher is implemented by agents that `entire` can subprocess-spawn.\n339: // This is used by `entire review` to start an agent with a pre-composed\n340: // initial prompt; other commands may use it later.\n341: //\n342: // Contract:\n343: //   - LaunchCmd builds an *exec.Cmd with stdin/stdout/stderr wired to the\n344: //     caller's TTY. The agent runs in the foreground and the call blocks.\n345: //   - The returned cmd is ready to Run() or Start(); it must NOT be modified\n346: //     by the caller except to set environment variables or working dir.\n347: //   - initialPrompt is the first user message to send to the agent.\n348: type Launcher interface {\n349: \tLaunchCmd(ctx context.Context, initialPrompt string) (*exec.Cmd, error)\n350: }\n351: \n352: // DiscoveredSkill describes one review-adjacent skill found on disk by a\n353: // SkillDiscoverer. Name is the agent-native invocation form (e.g. a\n354: // slash-prefixed command); Description is scraped from on-disk metadata\n355: // if available; SourcePath is kept for debug logging and is not shown to\n356: // the user.\n357: type DiscoveredSkill struct {\n358: \tName        string\n359: \tDescription string\n360: \tSourcePath  string\n361: }\n362: \n363: // SkillDiscoverer is implemented by agents that can enumerate review-adjacent\n364: // skills installed locally on disk (e.g. plugin skills under\n365: // ~/.claude/plugins/...). This powers the \"Installed plugin skills\" section\n366: // of the `entire review` picker and the runtime verification that configured\n367: // skills still exist before spawn.\n368: //\n369: // Contract:\n370: //   - Safe to call on fresh installs where no plugin dir exists yet —\n371: //     return (nil, nil), not an error.\n372: //   - Malformed individual skill metadata must be skipped with a Debug log,\n373: //     not propagated as an error.\n374: //   - A (nil, non-nil) error means \"discovery could not run at all\" (e.g.\n375: //     home dir inaccessible). Callers may treat all errors as \"found nothing\"\n376: //     and log at Debug — discovery must never block the picker.\n377: type SkillDiscoverer interface {\n378: \tAgent\n379: \tDiscoverReviewSkills(ctx context.Context) ([]DiscoveredSkill, error)\n380: }\n381: \n382: // SessionBaseDirProvider is implemented by agents that store transcripts in a\n383: // home-directory-based structure with per-project subdirectories. This enables\n384: // cross-project transcript search (e.g., when a session was started from a\n385: // different working directory). Agents with ephemeral/temp-based storage or\n386: // flat session layouts should NOT implement this interface.\n387: type SessionBaseDirProvider interface {\n388: \tAgent\n389: \n390: \t// GetSessionBaseDir returns the base directory containing per-project\n391: \t// session subdirectories (e.g., ~/.claude/projects, ~/.gemini/tmp).\n392: \tGetSessionBaseDir() (string, error)\n393: }\n394: \n395: // SubagentAwareExtractor provides methods for extracting files and tokens including subagents.\n396: // Agents that support spawning subagents (like Claude Code's Task tool) should implement this\n397: // to ensure subagent contributions are included in checkpoints.\n398: type SubagentAwareExtractor interface {\n399: \tAgent\n400: \n401: \t// ExtractAllModifiedFiles extracts files modified by both the main agent and any spawned subagents.\n402: \t// The subagentsDir parameter specifies where subagent transcripts are stored.\n403: \t// Returns a deduplicated list of all modified file paths.\n404: \tExtractAllModifiedFiles(transcriptData []byte, fromOffset int, subagentsDir string) ([]string, error)\n405: \n406: \t// CalculateTotalTokenUsage computes token usage including all spawned subagents.\n407: \t// The subagentsDir parameter specifies where subagent transcripts are stored\n408: \t// (an empty subagentsDir skips subagent accounting and leaves SubagentTokens nil).\n409: \t//\n410: \t// CONTRACT — the returned SubagentTokens is a CUMULATIVE-SINCE-SESSION-START\n411: \t// snapshot, NOT a delta scoped to fromOffset like the main-agent fields\n412: \t// (InputTokens/OutputTokens/...). Implementations MUST discover spawned agent\n413: \t// IDs from the FULL transcript prefix [0,end) — so a subagent spawned before\n414: \t// fromOffset is still found (#329) — and re-read each subagent transcript from\n415: \t// line 0 on every call. Consequently a subagent's full total repeats on every\n416: \t// call after it is first discovered.\n417: \t//\n418: \t// Callers that accumulate across checkpoints/turns therefore MUST NOT sum\n419: \t// SubagentTokens across calls: replace the running total with the latest\n420: \t// snapshot, and rescope any window delta by subtracting a previously captured\n421: \t// baseline (see accumulateTokenUsage / resetCheckpointWindow and\n422: \t// session.State.SubagentTokensBaseline in cmd/entire/cli/strategy, and\n423: \t// rescopeSubagentTokensToDeltas in cmd/entire/cli/agentimport for the import\n424: \t// path). An implementation that instead returned per-window deltas would\n425: \t// silently break that accounting with no compile-time or test signal.\n426: \tCalculateTotalTokenUsage(transcriptData []byte, fromOffset int, subagentsDir string) (*TokenUsage, error)\n427: }\n\n(End of file - total 427 lines)\n</content>",
