ed %d\",\n50: \t\t\tinfo.ProtocolVersion, ProtocolVersion)\n51: \t}\n52: \n53: \tea.info = &info\n54: \treturn ea, nil\n55: }\n56: \n57: // Info returns the cached info response.\n58: func (e *Agent) Info() *InfoResponse {\n59: \treturn e.info\n60: }\n61: \n62: // --- Agent interface: Identity ---\n63: \n64: func (e *Agent) Name() types.AgentName {\n65: \treturn types.AgentName(e.info.Name)\n66: }\n67: \n68: func (e *Agent) Type() types.AgentType {\n69: \treturn types.AgentType(e.info.Type)\n70: }\n71: \n72: func (e *Agent) Description() string {\n73: \treturn e.info.Description\n74: }\n75: \n76: func (e *Agent) IsPreview() bool {\n77: \treturn e.info.IsPreview\n78: }\n79: \n80: func (e *Agent) DetectPresence(ctx context.Context) (bool, error) {\n81: \tstdout, err := e.run(ctx, nil, \"detect\")\n82: \tif err != nil {\n83: \t\treturn false, fmt.Errorf(\"detect: %w\", err)\n84: \t}\n85: \tvar resp DetectResponse\n86: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n87: \t\treturn false, fmt.Errorf(\"detect: invalid JSON: %w\", err)\n88: \t}\n89: \treturn resp.Present, nil\n90: }\n91: \n92: func (e *Agent) ProtectedDirs() []string {\n93: \treturn e.info.ProtectedDirs\n94: }\n95: \n96: func (e *Agent) ProtectedFiles() []string {\n97: \treturn e.info.ProtectedFiles\n98: }\n99: \n100: // --- Agent interface: Transcript Storage ---\n101: \n102: func (e *Agent) ReadTranscript(sessionRef string) ([]byte, error) {\n103: \treturn e.run(context.Background(), nil, \"read-transcript\", \"--session-ref\", sessionRef)\n104: }\n105: \n106: func (e *Agent) ChunkTranscript(ctx context.Context, content []byte, maxSize int) ([][]byte, error) {\n107: \tstdout, err := e.run(ctx, content, \"chunk-transcript\", \"--max-size\", strconv.Itoa(maxSize))\n108: \tif err != nil {\n109: \t\treturn nil, fmt.Errorf(\"chunk-transcript: %w\", err)\n110: \t}\n111: \tvar resp ChunkResponse\n112: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n113: \t\treturn nil, fmt.Errorf(\"chunk-transcript: invalid JSON: %w\", err)\n114: \t}\n115: \treturn resp.Chunks, nil\n116: }\n117: \n118: func (e *Agent) ReassembleTranscript(chunks [][]byte) ([]byte, error) {\n119: \tinput, err := json.Marshal(ChunkResponse{Chunks: chunks})\n120: \tif err != nil {\n121: \t\treturn nil, fmt.Errorf(\"reassemble-transcript: marshal: %w\", err)\n122: \t}\n123: \treturn e.run(context.Background(), input, \"reassemble-transcript\")\n124: }\n125: \n126: func (e *Agent) CompactTranscript(ctx context.Context, sessionRef string) (*agent.CompactedTranscript, error) {\n127: \tstdout, err := e.run(ctx, nil, \"compact-transcript\", \"--session-ref\", sessionRef)\n128: \tif err != nil {\n129: \t\treturn nil, fmt.Errorf(\"compact-transcript: %w\", err)\n130: \t}\n131: \n132: \tvar resp CompactTranscriptResponse\n133: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n134: \t\treturn nil, fmt.Errorf(\"compact-transcript: invalid JSON: %w\", err)\n135: \t}\n136: \n137: \tcompacted, err := resp.toCompactedTranscript()\n138: \tif err != nil {\n139: \t\treturn nil, err\n140: \t}\n141: \treturn compacted, nil\n142: }\n143: \n144: // --- Agent interface: Legacy methods ---\n145: \n146: func (e *Agent) GetSessionID(input *agent.HookInput) string {\n147: \tdata, err := marshalHookInput(input)\n148: \tif err != nil {\n149: \t\treturn \"\"\n150: \t}\n151: \tstdout, err := e.run(context.Background(), data, \"get-session-id\")\n152: \tif err != nil {\n153: \t\treturn \"\"\n154: \t}\n155: \tvar resp SessionIDResponse\n156: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n157: \t\treturn \"\"\n158: \t}\n159: \treturn resp.SessionID\n160: }\n161: \n162: func (e *Agent) GetSessionDir(repoPath string) (string, error) {\n163: \tstdout, err := e.run(context.Background(), nil, \"get-session-dir\", \"--repo-path\", repoPath)\n164: \tif err != nil {\n165: \t\treturn \"\", fmt.Errorf(\"get-session-dir: %w\", err)\n166: \t}\n167: \tvar resp SessionDirResponse\n168: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n169: \t\treturn \"\", fmt.Errorf(\"get-session-dir: invalid JSON: %w\", err)\n170: \t}\n171: \treturn resp.SessionDir, nil\n172: }\n173: \n174: func (e *Agent) ResolveSessionFile(sessionDir, agentSessionID string) string {\n175: \tstdout, err := e.run(context.Background(), nil, \"resolve-session-file\",\n176: \t\t\"--session-dir\", sessionDir, \"--session-id\", agentSessionID)\n177: \tif err != nil {\n178: \t\treturn \"\"\n179: \t}\n180: \tvar resp SessionFileResponse\n181: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n182: \t\treturn \"\"\n183: \t}\n184: \treturn resp.SessionFile\n185: }\n186: \n187: func (e *Agent) ReadSession(input *agent.HookInput) (*agent.AgentSession, error) {\n188: \tdata, err := marshalHookInput(input)\n189: \tif err != nil {\n190: \t\treturn nil, fmt.Errorf(\"read-session: marshal: %w\", err)\n191: \t}\n192: \tstdout, err := e.run(context.Background(), data, \"read-session\")\n193: \tif err != nil {\n194: \t\treturn nil, fmt.Errorf(\"read-session: %w\", err)\n195: \t}\n196: \tvar resp AgentSessionJSON\n197: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n198: \t\treturn nil, fmt.Errorf(\"read-session: invalid JSON: %w\", err)\n199: \t}\n200: \treturn unmarshalAgentSession(&resp)\n201: }\n202: \n203: func (e *Agent) WriteSession(ctx context.Context, session *agent.AgentSession) error {\n204: \tdata, err := marshalAgentSession(session)\n205: \tif err != nil {\n206: \t\treturn fmt.Errorf(\"write-session: marshal: %w\", err)\n207: \t}\n208: \t_, err = e.run(ctx, data, \"write-session\")\n209: \tif err != nil {\n210: \t\treturn fmt.Errorf(\"write-session: %w\", err)\n211: \t}\n212: \treturn nil\n213: }\n214: \n215: func (e *Agent) FormatResumeCommand(sessionID string) string {\n216: \tstdout, err := e.run(context.Background(), nil, \"format-resume-command\", \"--session-id\", sessionID)\n217: \tif err != nil {\n218: \t\treturn \"\"\n219: \t}\n220: \tvar resp ResumeCommandResponse\n221: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n222: \t\treturn \"\"\n223: \t}\n224: \treturn resp.Command\n225: }\n226: \n227: // --- HookSupport methods (delegated when capabilities.hooks is true) ---\n228: \n229: func (e *Agent) HookNames() []string {\n230: \treturn e.info.HookNames\n231: }\n232: \n233: func (e *Agent) ParseHookEvent(ctx context.Context, hookName string, stdin io.Reader) (*agent.Event, error) {\n234: \tconst maxParseHookBytes = 10 * 1024 * 1024 // 10 MB\n235: \t// Stream a single (size-bounded) JSON value rather than io.ReadAll, so the\n236: \t// hook never blocks waiting for stdin EOF that some agents don't send on\n237: \t// Windows/Git Bash (issue #1398). The external \"parse-hook\" contract receives\n238: \t// the host's hook payload — which is JSON — and we forward its raw bytes\n239: \t// verbatim to the subprocess, so a plain byte copy is preserved.\n240: \traw, err := agent.ReadHookInputRawLimited(stdin, maxParseHookBytes)\n241: \tif err != nil {\n242: \t\treturn nil, fmt.Errorf(\"parse-hook: read stdin: %w\", err)\n243: \t}\n244: \tstdout, err := e.run(ctx, raw, \"parse-hook\", \"--hook\", hookName)\n245: \tif err != nil {\n246: \t\treturn nil, fmt.Errorf(\"parse-hook: %w\", err)\n247: \t}\n248: \t// null means no lifecycle significance\n249: \tif bytes.Equal(bytes.TrimSpace(stdout), []byte(\"null\")) {\n250: \t\treturn nil, nil //nolint:nilnil // protocol contract: null = no event\n251: \t}\n252: \tvar event eventJSON\n253: \tif err := json.Unmarshal(stdout, &event); err != nil {\n254: \t\treturn nil, fmt.Errorf(\"parse-hook: invalid JSON: %w\", err)\n255: \t}\n256: \treturn event.toEvent()\n257: }\n258: \n259: func (e *Agent) InstallHooks(ctx context.Context, localDev bool, force bool) (int, error) {\n260: \targs := []string{\"install-hooks\"}\n261: \tif localDev {\n262: \t\targs = append(args, \"--local-dev\")\n263: \t}\n264: \tif force {\n265: \t\targs = append(args, \"--force\")\n266: \t}\n267: \tstdout, err := e.run(ctx, nil, args...)\n268: \tif err != nil {\n269: \t\treturn 0, fmt.Errorf(\"install-hooks: %w\", err)\n270: \t}\n271: \tvar resp HooksInstalledCountResponse\n272: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n273: \t\treturn 0, fmt.Errorf(\"install-hooks: invalid JSON: %w\", err)\n274: \t}\n275: \treturn resp.HooksInstalled, nil\n276: }\n277: \n278: func (e *Agent) UninstallHooks(ctx context.Context) error {\n279: \t_, err := e.run(ctx, nil, \"uninstall-hooks\")\n280: \tif err != nil {\n281: \t\treturn fmt.Errorf(\"uninstall-hooks: %w\", err)\n282: \t}\n283: \treturn nil\n284: }\n285: \n286: func (e *Agent) AreHooksInstalled(ctx context.Context) bool {\n287: \tstdout, err := e.run(ctx, nil, \"are-hooks-installed\")\n288: \tif err != nil {\n289: \t\treturn false\n290: \t}\n291: \tvar resp AreHooksInstalledResponse\n292: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n293: \t\treturn false\n294: \t}\n295: \treturn resp.Installed\n296: }\n297: \n298: // --- TranscriptAnalyzer methods ---\n299: \n300: func (e *Agent) GetTranscriptPosition(path string) (int, error) {\n301: \tstdout, err := e.run(context.Background(), nil, \"get-transcript-position\", \"--path\", path)\n302: \tif err != nil {\n303: \t\treturn 0, fmt.Errorf(\"get-transcript-position: %w\", err)\n304: \t}\n305: \tvar resp TranscriptPositionResponse\n306: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n307: \t\treturn 0, fmt.Errorf(\"get-transcript-position: invalid JSON: %w\", err)\n308: \t}\n309: \treturn resp.Position, nil\n310: }\n311: \n312: func (e *Agent) ExtractModifiedFilesFromOffset(path string, startOffset int) ([]string, int, error) {\n313: \tstdout, err := e.run(context.Background(), nil, \"extract-modified-files\",\n314: \t\t\"--path\", path, \"--offset\", strconv.Itoa(startOffset))\n315: \tif err != nil {\n316: \t\treturn nil, 0, fmt.Errorf(\"extract-modified-files: %w\", err)\n317: \t}\n318: \tvar resp ExtractFilesResponse\n319: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n320: \t\treturn nil, 0, fmt.Errorf(\"extract-modified-files: invalid JSON: %w\", err)\n321: \t}\n322: \treturn resp.Files, resp.CurrentPosition, nil\n323: }\n324: \n325: func (e *Agent) ExtractPrompts(sessionRef string, fromOffset int) ([]string, error) {\n326: \tstdout, err := e.run(context.Background(), nil, \"extract-prompts\",\n327: \t\t\"--session-ref\", sessionRef, \"--offset\", strconv.Itoa(fromOffset))\n328: \tif err != nil {\n329: \t\treturn nil, fmt.Errorf(\"extract-prompts: %w\", err)\n330: \t}\n331: \tvar resp ExtractPromptsResponse\n332: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n333: \t\treturn nil, fmt.Errorf(\"extract-prompts: invalid JSON: %w\", err)\n334: \t}\n335: \treturn resp.Prompts, nil\n336: }\n337: \n338: func (e *Agent) ExtractSummary(sessionRef string) (string, error) {\n339: \tstdout, err := e.run(context.Background(), nil, \"extract-summary\", \"--session-ref\", sessionRef)\n340: \tif err != nil {\n341: \t\treturn \"\", fmt.Errorf(\"extract-summary: %w\", err)\n342: \t}\n343: \tvar resp ExtractSummaryResponse\n344: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n345: \t\treturn \"\", fmt.Errorf(\"extract-summary: invalid JSON: %w\", err)\n346: \t}\n347: \treturn resp.Summary, nil\n348: }\n349: \n350: // --- TranscriptPreparer methods ---\n351: \n352: func (e *Agent) PrepareTranscript(ctx context.Context, sessionRef string) error {\n353: \t_, err := e.run(ctx, nil, \"prepare-transcript\", \"--session-ref\", sessionRef)\n354: \tif err != nil {\n355: \t\treturn fmt.Errorf(\"prepare-transcript: %w\", err)\n356: \t}\n357: \treturn nil\n358: }\n359: \n360: // --- TokenCalculator methods ---\n361: \n362: func (e *Agent) CalculateTokenUsage(transcriptData []byte, fromOffset int) (*agent.TokenUsage, error) {\n363: \tstdout, err := e.run(context.Background(), transcriptData,\n364: \t\t\"calculate-tokens\", \"--offset\", strconv.Itoa(fromOffset))\n365: \tif err != nil {\n366: \t\treturn nil, fmt.Errorf(\"calculate-tokens: %w\", err)\n367: \t}\n368: \tvar resp TokenUsageResponse\n369: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n370: \t\treturn nil, fmt.Errorf(\"calculate-tokens: invalid JSON: %w\", err)\n371: \t}\n372: \treturn convertTokenUsage(&resp), nil\n373: }\n374: \n375: // --- TextGenerator methods ---\n376: \n377: func (e *Agent) GenerateText(ctx context.Context, prompt string, model string) (string, error) {\n378: \tstdout, err := e.run(ctx, []byte(prompt), \"generate-text\", \"--model\", model)\n379: \tif err != nil {\n380: \t\treturn \"\", fmt.Errorf(\"generate-text: %w\", err)\n381: \t}\n382: \tvar resp GenerateTextResponse\n383: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n384: \t\treturn \"\", fmt.Errorf(\"generate-text: invalid JSON: %w\", err)\n385: \t}\n386: \treturn resp.Text, nil\n387: }\n388: \n389: // --- HookResponseWriter methods ---\n390: \n391: func (e *Agent) WriteHookResponse(message string) error {\n392: \t_, err := e.run(context.Background(), nil, \"write-hook-response\", \"--message\", message)\n393: \tif err != nil {\n394: \t\treturn fmt.Errorf(\"write-hook-response: %w\", err)\n395: \t}\n396: \treturn nil\n397: }\n398: \n399: // --- SubagentAwareExtractor methods ---\n400: \n401: func (e *Agent) ExtractAllModifiedFiles(transcriptData []byte, fromOffset int, subagentsDir string) ([]string, error) {\n402: \tstdout, err := e.run(context.Background(), transcriptData,\n403: \t\t\"extract-all-modified-files\", \"--offset\", strconv.Itoa(fromOffset), \"--subagents-dir\", subagentsDir)\n404: \tif err != nil {\n405: \t\treturn nil, fmt.Errorf(\"extract-all-modified-files: %w\", err)\n406: \t}\n407: \tvar resp ExtractFilesResponse\n408: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n409: \t\treturn nil, fmt.Errorf(\"extract-all-modified-files: invalid JSON: %w\", err)\n410: \t}\n411: \treturn resp.Files, nil\n412: }\n413: \n414: func (e *Agent) CalculateTotalTokenUsage(transcriptData []byte, fromOffset int, subagentsDir string) (*agent.TokenUsage, error) {\n415: \tstdout, err := e.run(context.Background(), transcriptData,\n416: \t\t\"calculate-total-tokens\", \"--offset\", strconv.Itoa(fromOffset), \"--subagents-dir\", subagentsDir)\n417: \tif err != nil {\n418: \t\treturn nil, fmt.Errorf(\"calculate-total-tokens: %w\", err)\n419: \t}\n420: \tvar resp TokenUsageResponse\n421: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n422: \t\treturn nil, fmt.Errorf(\"calculate-total-tokens: invalid JSON: %w\", err)\n423: \t}\n424: \treturn convertTokenUsage(&resp), nil\n425: }\n426: \n427: // run executes a subcommand on the external binary and returns stdout bytes.\n428: // If stdin is non-nil it is piped to the process. On non-zero exit, stderr is\n429: // included in the returned error.\n430: func (e *Agent) run(ctx context.Context, stdin []byte, args ...string) ([]byte, error) {\n431: \t// Apply a default timeout when the caller hasn't set a deadline, so a hung\n432: \t// external binary can't block the CLI (or git hooks) indefinitely.\n433: \tif _, ok := ctx.Deadline(); !ok {\n434: \t\tvar cancel context.CancelFunc\n435: \t\tctx, cancel = context.WithTimeout(ctx, defaultRunTimeout)\n436: \t\tdefer cancel()\n437: \t}\n438: \tcmd := exec.CommandContext(ctx, e.binaryPath, args...)\n439: \t// Ensure I/O goroutines are released shortly after the process is killed,\n440: \t// so cmd.Run() doesn't block waiting for pipe reads.\n441: \tcmd.WaitDelay = 3 * time.Second\n442: \n443: \tcmd.Env = append(cmd.Environ(),\n444: \t\t\"ENTIRE_PROTOCOL_VERSION=\"+strconv.Itoa(ProtocolVersion),\n445: \t\t\"ENTIRE_CLI_VERSION=\"+versioninfo.Version,\n446: \t)\n447: \tif repoRoot, err := paths.WorktreeRoot(ctx); err == nil {\n448: \t\tcmd.Env = append(cmd.Env, \"ENTIRE_REPO_ROOT=\"+repoRoot)\n449: \t\tcmd.Dir = repoRoot\n450: \t}\n451: \n452: \tif stdin != nil {\n453: \t\tcmd.Stdin = bytes.NewReader(stdin)\n454: \t}\n455: \n456: \tconst maxOutputBytes = 10 * 1024 * 1024 // 10 MB\n457: \n458: \tvar stdoutBuf, stderrBuf bytes.Buffer\n459: \tstdoutLW := &limitedWriter{buf: &stdoutBuf, limit: maxOutputBytes}\n460: \tstderrLW := &limitedWriter{buf: &stderrBuf, limit: maxOutputBytes}\n461: \tcmd.Stdout = stdoutLW\n462: \tcmd.Stderr = stderrLW\n463: \n464: \tif err := cmd.Run(); err != nil {\n465: \t\terrMsg := strings.TrimSpace(stderrBuf.String())\n466: \t\tif errMsg != \"\" {\n467: \t\t\treturn nil, fmt.Errorf(\"%s: %s\", args[0], errMsg)\n468: \t\t}\n469: \t\treturn nil, fmt.Errorf(\"%s: %w\", args[0], err)\n470: \t}\n471: \n472: \tif stdoutLW.truncated {\n473: \t\treturn nil, fmt.Errorf(\"%s: output exceeded %d byte limit\", args[0], maxOutputBytes)\n474: \t}\n475: \n476: \treturn stdoutBuf.Bytes(), nil\n477: }\n478: \n479: // --- Helpers ---\n480: \n481: // limitedWriter wraps a bytes.Buffer and stops writing after limit bytes,\n482: // preventing unbounded memory growth from external process output.\n483: type limitedWriter struct {\n484: \tbuf       *bytes.Buffer\n485: \tlimit     int\n486: \ttruncated bool\n487: }\n488: \n489: func (w *limitedWriter) Write(p []byte) (int, error) {\n490: \tremaining := w.limit - w.buf.Len()\n491: \tif remaining <= 0 {\n492: \t\tw.truncated = true\n493: \t\treturn len(p), nil // discard, but report success so the process isn't killed\n494: \t}\n495: \tif len(p) > remaining {\n496: \t\tp = p[:remaining]\n497: \t\tw.truncated = true\n498: \t}\n499: \tn, err := w.buf.Write(p)\n500: \tif err != nil {\n501: \t\treturn n, fmt.Errorf(\"writing to limited buffer: %w\", err)\n502: \t}\n503: \treturn n, nil\n504: }\n505: \n506: func marshalHookInput(input *agent.HookInput) ([]byte, error) {\n507: \tif input == nil {\n508: \t\treturn []byte(\"{}\"), nil\n509: \t}\n510: \tj := HookInputJSON{\n511: \t\tHookType:   string(input.HookType),\n512: \t\tSessionID:  input.SessionID,\n513: \t\tSessionRef: input.SessionRef,\n514: \t\tTimestamp:  input.Timestamp.Format(time.RFC3339),\n515: \t\tUserPrompt: input.UserPrompt,\n516: \t\tToolName:   input.ToolName,\n517: \t\tToolUseID:  input.ToolUseID,\n518: \t\tToolInput:  input.ToolInput,\n519: \t\tRawData:    input.RawData,\n520: \t}\n521: \tdata, err := json.Marshal(j)\n522: \tif err != nil {\n523: \t\treturn nil, fmt.Errorf(\"marshal hook input: %w\", err)\n524: \t}\n525: \treturn data, nil\n526: }\n527: \n528: func marshalAgentSession(s *agent.AgentSession) ([]byte, error) {\n529: \tj := AgentSessionJSON{\n530: \t\tSessionID:     s.SessionID,\n531: \t\tAgentName:     string(s.AgentName),\n532: \t\tRepoPath:      s.RepoPath,\n533: \t\tSessionRef:    s.SessionRef,\n534: \t\tStartTime:     s.StartTime.Format(time.RFC3339),\n535: \t\tNativeData:    s.NativeData,\n536: \t\tModifiedFiles: s.ModifiedFiles,\n537: \t\tNewFiles:      s.NewFiles,\n538: \t\tDeletedFiles:  s.DeletedFiles,\n539: \t}\n540: \tdata, err := json.Marshal(j)\n541: \tif err != nil {\n542: \t\treturn nil, fmt.Errorf(\"marshal agent session: %w\", err)\n543: \t}\n544: \treturn data, nil\n545: }\n546: \n547: func unmarshalAgentSession(j *AgentSessionJSON) (*agent.AgentSession, error) {\n548: \tvar startTime time.Time\n549: \tif j.StartTime != \"\" {\n550: \t\tvar err error\n551: \t\tstartTime, err = time.Parse(time.RFC3339, j.StartTime)\n552: \t\tif err != nil {\n553: \t\t\treturn nil, fmt.Errorf(\"invalid start_time: %w\", err)\n554: \t\t}\n555: \t}\n556: \treturn &agent.AgentSession{\n557: \t\tSessionID:     j.SessionID,\n558: \t\tAgentName:     types.AgentName(j.AgentName),\n559: \t\tRepoPath:      j.RepoPath,\n560: \t\tSessionRef:    j.SessionRef,\n561: \t\tStartTime:     startTime,\n562: \t\tNativeData:    j.NativeData,\n563: \t\tModifiedFiles: j.ModifiedFiles,\n564: \t\tNewFiles:      j.NewFiles,\n565: \t\tDeletedFiles:  j.DeletedFiles,\n566: \t}, nil\n567: }\n568: \n569: func convertTokenUsage(r *TokenUsageResponse) *agent.TokenUsage {\n570: \tif r == nil {\n571: \t\treturn nil\n572: \t}\n573: \tusage := &agent.TokenUsage{\n574: \t\tInputTokens:         r.InputTokens,\n575: \t\tCacheCreationTokens: r.Cache