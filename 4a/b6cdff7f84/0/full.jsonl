s.\n50: func DiscoverAndRegisterAlways(ctx context.Context) {\n51: \tdiscoverAndRegister(ctx)\n52: }\n53: \n54: // DiscoverAndRegisterNamedAlways discovers and registers only the external\n55: // agent binary matching name. It bypasses the external_agents setting for\n56: // explicit, one-invocation selections without executing unrelated plugins.\n57: func DiscoverAndRegisterNamedAlways(ctx context.Context, name types.AgentName) error {\n58: \treturn discoverAndRegisterNamed(ctx, name, discoveryTimeout)\n59: }\n60: \n61: func discoverAndRegisterNamed(ctx context.Context, name types.AgentName, timeout time.Duration) error {\n62: \tif name == \"\" {\n63: \t\treturn nil\n64: \t}\n65: \tif strings.ContainsAny(string(name), `/\\`) {\n66: \t\treturn fmt.Errorf(\"invalid external agent name %q: contains path separators\", name)\n67: \t}\n68: \tif _, err := agent.Get(name); err == nil {\n69: \t\treturn nil\n70: \t}\n71: \n72: \tctx, cancel := context.WithTimeout(ctx, timeout)\n73: \tdefer cancel()\n74: \tif err := ctx.Err(); err != nil {\n75: \t\treturn fmt.Errorf(\"discovering external agent %q: %w\", name, err)\n76: \t}\n77: \n78: \tbinName := binaryPrefix + string(name)\n79: \tbinPath, err := lookPathExternalAgent(binName)\n80: \tif ctxErr := ctx.Err(); ctxErr != nil {\n81: \t\treturn fmt.Errorf(\"looking up external agent %q binary %q: %w\", name, binName, ctxErr)\n82: \t}\n83: \tif err != nil {\n84: \t\tif errors.Is(err, exec.ErrNotFound) {\n85: \t\t\treturn nil\n86: \t\t}\n87: \t\treturn fmt.Errorf(\"looking up external agent %q binary %q: %w\", name, binName, err)\n88: \t}\n89: \tregistered, err := registerExternalAgent(ctx, binPath, name)\n90: \tif err != nil {\n91: \t\treturn err\n92: \t}\n93: \tif !registered {\n94: \t\treturn fmt.Errorf(\"external agent %q binary %q was found but could not be registered\", name, binPath)\n95: \t}\n96: \treturn nil\n97: }\n98: \n99: // discoverAndRegister contains the shared scanning logic for external agent discovery.\n100: func discoverAndRegister(ctx context.Context) {\n101: \tctx, cancel := context.WithTimeout(ctx, discoveryTimeout)\n102: \tdefer cancel()\n103: \n104: \tpathEnv := os.Getenv(\"PATH\")\n105: \tif pathEnv == \"\" {\n106: \t\treturn\n107: \t}\n108: \n109: \t// Collect already-registered names to avoid conflicts.\n110: \tregistered := make(map[types.AgentName]bool)\n111: \tfor _, name := range agent.List() {\n112: \t\tregistered[name] = true\n113: \t}\n114: \n115: \tseen := make(map[string]bool) // deduplicate binaries across PATH dirs\n116: \tfor _, dir := range filepath.SplitList(pathEnv) {\n117: \t\tif ctx.Err() != nil {\n118: \t\t\tlogging.Debug(ctx, \"external agent discovery timed out\")\n119: \t\t\treturn\n120: \t\t}\n121: \n122: \t\tmatches, err := filepath.Glob(filepath.Join(dir, binaryPrefix+\"*\"))\n123: \t\tif err != nil {\n124: \t\t\tcontinue // skip unreadable directories\n125: \t\t}\n126: \t\tfor _, binPath := range matches {\n127: \t\t\tif ctx.Err() != nil {\n128: \t\t\t\tlogging.Debug(ctx, \"external agent discovery timed out\")\n129: \t\t\t\treturn\n130: \t\t\t}\n131: \n132: \t\t\tname := filepath.Base(binPath)\n133: \t\t\tif seen[name] {\n134: \t\t\t\tcontinue\n135: \t\t\t}\n136: \t\t\tseen[name] = true\n137: \n138: \t\t\t// Strip Windows executable extensions (.exe, .bat) before deriving agent name.\n139: \t\t\t// On Unix, binaries have no extension, so this is a no-op.\n140: \t\t\tcleanName := StripExeExt(name)\n141: \t\t\tagentName := types.AgentName(strings.TrimPrefix(cleanName, binaryPrefix))\n142: \t\t\tif registered[agentName] {\n143: \t\t\t\tlogging.Debug(ctx, \"skipping external agent (name conflict with built-in)\",\n144: \t\t\t\t\tslog.String(\"binary\", name),\n145: \t\t\t\t\tslog.String(\"agent\", string(agentName)))\n146: \t\t\t\tcontinue\n147: \t\t\t}\n148: \n149: \t\t\tregisteredAgent, err := registerExternalAgent(ctx, binPath, agentName)\n150: \t\t\tif err != nil {\n151: \t\t\t\tlogging.Debug(ctx, \"skipping external agent (registration failed)\",\n152: \t\t\t\t\tslog.String(\"binary\", binPath),\n153: \t\t\t\t\tslog.String(\"agent\", string(agentName)),\n154: \t\t\t\t\tslog.String(\"error\", err.Error()))\n155: \t\t\t\tcontinue\n156: \t\t\t}\n157: \t\t\tif registeredAgent {\n158: \t\t\t\tregistered[agentName] = true\n159: \t\t\t}\n160: \t\t}\n161: \t}\n162: }\n163: \n164: func registerExternalAgent(ctx context.Context, binPath string, name types.AgentName) (bool, error) {\n165: \tfinfo, err := statExternalAgent(binPath)\n166: \tif err != nil {\n167: \t\tif errors.Is(err, os.ErrNotExist) {\n168: \t\t\treturn false, nil\n169: \t\t}\n170: \t\treturn false, fmt.Errorf(\"inspecting external agent %q binary %q: %w\", name, binPath, err)\n171: \t}\n172: \tif finfo.IsDir() {\n173: \t\treturn false, nil\n174: \t}\n175: \t// Check executable bit (on Unix; Windows doesn't set execute bits).\n176: \tif runtime.GOOS != osWindows && finfo.Mode()&0o111 == 0 {\n177: \t\treturn false, nil\n178: \t}\n179: \n180: \tea, err := New(ctx, binPath)\n181: \tif err != nil {\n182: \t\tif ctxErr := ctx.Err(); ctxErr != nil {\n183: \t\t\treturn false, fmt.Errorf(\"loading info for external agent %q from binary %q: %w: %w\", name, binPath, ctxErr, err)\n184: \t\t}\n185: \t\treturn false, fmt.Errorf(\"loading info for external agent %q from binary %q: %w\", name, binPath, err)\n186: \t}\n187: \n188: \twrapped, err := Wrap(ea)\n189: \tif err != nil {\n190: \t\treturn false, fmt.Errorf(\"wrapping external agent %q from binary %q: %w\", name, binPath, err)\n191: \t}\n192: \tagent.Register(name, func() agent.Agent {\n193: \t\treturn wrapped\n194: \t})\n195: \n196: \tlogging.Debug(ctx, \"registered external agent\",\n197: \t\tslog.String(\"name\", string(name)),\n198: \t\tslog.String(\"type\", string(ea.Type())),\n199: \t\tslog.String(\"binary\", binPath))\n200: \treturn true, nil\n201: }\n202: \n203: // StripExeExt removes Windows executable extensions (.exe, .bat, .cmd, .com)\n204: // from a file name so that the derived name matches