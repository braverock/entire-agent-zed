            "output": "<path>/tmp/opencode/entireio-cli/cmd/entire/cli/agent/external/types.go</path>\n<type>file</type>\n<content>\n1: // Package external provides an adapter that bridges external agent binaries\n2: // (discovered via PATH as entire-agent-<name>) to the agent.Agent interface.\n3: // Communication uses a subcommand-based protocol with JSON over stdin/stdout.\n4: package external\n5: \n6: import (\n7: \t\"encoding/base64\"\n8: \t\"encoding/json\"\n9: \t\"errors\"\n10: \t\"fmt\"\n11: \t\"time\"\n12: \n13: \t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n14: )\n15: \n16: // ProtocolVersion is the current protocol version expected by the CLI.\n17: const ProtocolVersion = 1\n18: \n19: // InfoResponse is the JSON returned by the \"info\" subcommand.\n20: type InfoResponse struct {\n21: \tProtocolVersion int                `json:\"protocol_version\"`\n22: \tName            string             `json:\"name\"`\n23: \tType            string             `json:\"type\"`\n24: \tDescription     string             `json:\"description\"`\n25: \tIsPreview       bool               `json:\"is_preview\"`\n26: \tProtectedDirs   []string           `json:\"protected_dirs\"`\n27: \tProtectedFiles  []string           `json:\"protected_files\"`\n28: \tHookNames       []string           `json:\"hook_names\"`\n29: \tCapabilities    agent.DeclaredCaps `json:\"capabilities\"`\n30: }\n31: \n32: // DetectResponse is the JSON returned by the \"detect\" subcommand.\n33: type DetectResponse struct {\n34: \tPresent bool `json:\"present\"`\n35: }\n36: \n37: // SessionIDResponse is the JSON returned by the \"get-session-id\" subcommand.\n38: type SessionIDResponse struct {\n39: \tSessionID string `json:\"session_id\"`\n40: }\n41: \n42: // SessionDirResponse is the JSON returned by the \"get-session-dir\" subcommand.\n43: type SessionDirResponse struct {\n44: \tSessionDir string `json:\"session_dir\"`\n45: }\n46: \n47: // SessionFileResponse is the JSON returned by the \"resolve-session-file\" subcommand.\n48: type SessionFileResponse struct {\n49: \tSessionFile string `json:\"session_file\"`\n50: }\n51: \n52: // ChunkResponse is the JSON returned by the \"chunk-transcript\" subcommand.\n53: type ChunkResponse struct {\n54: \tChunks [][]byte `json:\"chunks\"`\n55: }\n56: \n57: // ResumeCommandResponse is the JSON returned by the \"format-resume-command\" subcommand.\n58: type ResumeCommandResponse struct {\n59: \tCommand string `json:\"command\"`\n60: }\n61: \n62: // HooksInstalledCountResponse is the JSON returned by the \"install-hooks\" subcommand.\n63: type HooksInstalledCountResponse struct {\n64: \tHooksInstalled int `json:\"hooks_installed\"`\n65: }\n66: \n67: // AreHooksInstalledResponse is the JSON returned by the \"are-hooks-installed\" subcommand.\n68: type AreHooksInstalledResponse struct {\n69: \tInstalled bool `json:\"installed\"`\n70: }\n71: \n72: // TranscriptPositionResponse is the JSON returned by the \"get-transcript-position\" subcommand.\n73: type TranscriptPositionResponse struct {\n74: \tPosition int `json:\"position\"`\n75: }\n76: \n77: // ExtractFilesResponse is the JSON returned by file-extraction subcommands.\n78: type ExtractFilesResponse struct {\n79: \tFiles           []string `json:\"files\"`\n80: \tCurrentPosition int      `json:\"current_position\"`\n81: }\n82: \n83: // ExtractPromptsResponse is the JSON returned by the \"extract-prompts\" subcommand.\n84: type ExtractPromptsResponse struct {\n85: \tPrompts []string `json:\"prompts\"`\n86: }\n87: \n88: // ExtractSummaryResponse is the JSON returned by the \"extract-summary\" subcommand.\n89: type ExtractSummaryResponse struct {\n90: \tSummary    string `json:\"summary\"`\n91: \tHasSummary bool   `json:\"has_summary\"`\n92: }\n93: \n94: // TokenUsageResponse is the JSON returned by token calculation subcommands.\n95: type TokenUsageResponse struct {\n96: \tInputTokens         int                 `json:\"input_tokens\"`\n97: \tCacheCreationTokens int                 `json:\"cache_creation_tokens\"`\n98: \tCacheReadTokens     int                 `json:\"cache_read_tokens\"`\n99: \tOutputTokens        int                 `json:\"output_tokens\"`\n100: \tAPICallCount        int                 `json:\"api_call_count\"`\n101: \tSubagentTokens      *TokenUsageResponse `json:\"subagent_tokens,omitempty\"`\n102: }\n103: \n104: // GenerateTextResponse is the JSON returned by the \"generate-text\" subcommand.\n105: type GenerateTextResponse struct {\n106: \tText string `json:\"text\"`\n107: }\n108: \n109: // CompactTranscriptResponse is the JSON returned by the \"compact-transcript\" subcommand.\n110: type CompactTranscriptResponse struct {\n111: \tTranscript string                           `json:\"transcript\"`\n112: \tAssets     []CompactTranscriptAssetResponse `json:\"assets,omitempty\"`\n113: }\n114: \n115: // CompactTranscriptAssetResponse describes one extracted binary asset.\n116: type CompactTranscriptAssetResponse struct {\n117: \tName      string `json:\"name\"`\n118: \tMediaType string `json:\"media_type\"`\n119: \tData      string `json:\"data\"`\n120: }\n121: \n122: func (r *CompactTranscriptResponse) toCompactedTranscript() (*agent.CompactedTranscript, error) {\n123: \tif r.Transcript == \"\" {\n124: \t\treturn nil, errors.New(\"compact-transcript: missing transcript\")\n125: \t}\n126: \n127: \ttranscript, err := base64.StdEncoding.DecodeString(r.Transcript)\n128: \tif err != nil {\n129: \t\treturn nil, fmt.Errorf(\"compact-transcript: decode transcript base64: %w\", err)\n130: \t}\n131: \n132: \tresult := &agent.CompactedTranscript{\n133: \t\tTranscript: transcript,\n134: \t}\n135: \tif len(r.Assets) == 0 {\n136: \t\treturn result, nil\n137: \t}\n138: \n139: \tresult.Assets = make([]agent.CompactedTranscriptAsset, 0, len(r.Assets))\n140: \tfor i, asset := range r.Assets {\n141: \t\tif asset.Name == \"\" {\n142: \t\t\treturn nil, fmt.Errorf(\"compact-transcript: asset[%d] missing name\", i)\n143: \t\t}\n144: \t\tif asset.MediaType == \"\" {\n145: \t\t\treturn nil, fmt.Errorf(\"compact-transcript: asset %q missing media_type\", asset.Name)\n146: \t\t}\n147: \t\tdata, decodeErr := base64.StdEncoding.DecodeString(asset.Data)\n148: \t\tif decodeErr != nil {\n149: \t\t\treturn nil, fmt.Errorf(\"compact-transcript: decode asset %q base64: %w\", asset.Name, decodeErr)\n150: \t\t}\n151: \t\tresult.Assets = append(result.Assets, agent.CompactedTranscriptAsset{\n152: \t\t\tName:      asset.Name,\n153: \t\t\tMediaType: asset.MediaType,\n154: \t\t\tData:      data,\n155: \t\t})\n156: \t}\n157: \n158: \treturn result, nil\n159: }\n160: \n161: // AgentSessionJSON is the JSON representation of agent.AgentSession for stdin/stdout transfer.\n162: type AgentSessionJSON struct {\n163: \tSessionID     string   `json:\"session_id\"`\n164: \tAgentName     string   `json:\"agent_name\"`\n165: \tRepoPath      string   `json:\"repo_path\"`\n166: \tSessionRef    string   `json:\"session_ref\"`\n167: \tStartTime     string   `json:\"start_time\"`\n168: \tNativeData    []byte   `json:\"native_data\"`\n169: \tModifiedFiles []string `json:\"modified_files\"`\n170: \tNewFiles      []string `json:\"new_files\"`\n171: \tDeletedFiles  []string `json:\"deleted_files\"`\n172: }\n173: \n174: // eventJSON is the JSON-tagged representation of agent.Event for protocol transfer.\n175: type eventJSON struct {\n176: \tType              int               `json:\"type\"`\n177: \tSessionID         string            `json:\"session_id\"`\n178: \tPreviousSessionID string            `json:\"previous_session_id,omitempty\"`\n179: \tSessionRef        string            `json:\"session_ref,omitempty\"`\n180: \tPrompt            string            `json:\"prompt,omitempty\"`\n181: \tModel             string            `json:\"model,omitempty\"`\n182: \tTimestamp         string            `json:\"timestamp,omitempty\"`\n183: \tToolUseID         string            `json:\"tool_use_id,omitempty\"`\n184: \tSubagentID        string            `json:\"subagent_id,omitempty\"`\n185: \tToolInput         json.RawMessage   `json:\"tool_input,omitempty\"`\n186: \tSubagentType      string            `json:\"subagent_type,omitempty\"`\n187: \tTaskDescription   string            `json:\"task_description,omitempty\"`\n188: \tResponseMessage   string            `json:\"response_message,omitempty\"`\n189: \tMetadata          map[string]string `json:\"metadata,omitempty\"`\n190: }\n191: \n192: func (ej *eventJSON) toEvent() (*agent.Event, error) {\n193: \tev := &agent.Event{\n194: \t\tType:              agent.EventType(ej.Type),\n195: \t\tSessionID:         ej.SessionID,\n196: \t\tPreviousSessionID: ej.PreviousSessionID,\n197: \t\tSessionRef:        ej.SessionRef,\n198: \t\tPrompt:            ej.Prompt,\n199: \t\tModel:             ej.Model,\n200: \t\tToolUseID:         ej.ToolUseID,\n201: \t\tSubagentID:        ej.SubagentID,\n202: \t\tToolInput:         ej.ToolInput,\n203: \t\tSubagentType:      ej.SubagentType,\n204: \t\tTaskDescription:   ej.TaskDescription,\n205: \t\tResponseMessage:   ej.ResponseMessage,\n206: \t\tMetadata:          ej.Metadata,\n207: \t}\n208: \tif ej.Timestamp != \"\" {\n209: \t\tt, err := time.Parse(time.RFC3339, ej.Timestamp)\n210: \t\tif err != nil {\n211: \t\t\treturn nil, fmt.Errorf(\"invalid timestamp: %w\", err)\n212: \t\t}\n213: \t\tev.Timestamp = t\n214: \t}\n215: \treturn ev, nil\n216: }\n217: \n218: // HookInputJSON is the JSON representation of agent.HookInput for stdin/stdout transfer.\n219: type HookInputJSON struct {\n220: \tHookType   string                 `json:\"hook_type\"`\n221: \tSessionID  string                 `json:\"session_id\"`\n222: \tSessionRef string                 `json:\"session_ref\"`\n223: \tTimestamp  string                 `json:\"timestamp\"`\n224: \tUserPrompt string                 `json:\"user_prompt,omitempty\"`\n225: \tToolName   string                 `json:\"tool_name,omitempty\"`\n226: \tToolUseID  string                 `json:\"tool_use_id,om