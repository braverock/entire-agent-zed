ed %d\",\n50: \t\t\tinfo.ProtocolVersion, ProtocolVersion)\n51: \t}\n52: \n53: \tea.info = &info\n54: \treturn ea, nil\n55: }\n56: \n57: // Info returns the cached info response.\n58: func (e *Agent) Info() *InfoResponse {\n59: \treturn e.info\n60: }\n61: \n62: // --- Agent interface: Identity ---\n63: \n64: func (e *Agent) Name() types.AgentName {\n65: \treturn types.AgentName(e.info.Name)\n66: }\n67: \n68: func (e *Agent) Type() types.AgentType {\n69: \treturn types.AgentType(e.info.Type)\n70: }\n71: \n72: func (e *Agent) Description() string {\n73: \treturn e.info.Description\n74: }\n75: \n76: func (e *Agent) IsPreview() bool {\n77: \treturn e.info.IsPreview\n78: }\n79: \n80: func (e *Agent) DetectPresence(ctx context.Context) (bool, error) {\n81: \tstdout, err := e.run(ctx, nil, \"detect\")\n82: \tif err != nil {\n83: \t\treturn false, fmt.Errorf(\"detect: %w\", err)\n84: \t}\n85: \tvar resp DetectResponse\n86: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n87: \t\treturn false, fmt.Errorf(\"detect: invalid JSON: %w\", err)\n88: \t}\n89: \treturn resp.Present, nil\n90: }\n91: \n92: func (e *Agent) ProtectedDirs() []string {\n93: \treturn e.info.ProtectedDirs\n94: }\n95: \n96: func (e *Agent) ProtectedFiles() []string {\n97: \treturn e.info.ProtectedFiles\n98: }\n99: \n100: // --- Agent interface: Transcript Storage ---\n101: \n102: func (e *Agent) ReadTranscript(sessionRef string) ([]byte, error) {\n103: \treturn e.run(context.Background(), nil, \"read-transcript\", \"--session-ref\", sessionRef)\n104: }\n105: \n106: func (e *Agent) ChunkTranscript(ctx context.Context, content []byte, maxSize int) ([][]byte, error) {\n107: \tstdout, err := e.run(ctx, content, \"chunk-transcript\", \"--max-size\", strconv.Itoa(maxSize))\n108: \tif err != nil {\n109: \t\treturn nil, fmt.Errorf(\"chunk-transcript: %w\", err)\n110: \t}\n111: \tvar resp ChunkResponse\n112: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n113: \t\treturn nil, fmt.Errorf(\"chunk-transcript: invalid JSON: %w\", err)\n114: \t}\n115: \treturn resp.Chunks, nil\n116: }\n117: \n118: func (e *Agent) ReassembleTranscript(chunks [][]byte) ([]byte, error) {\n119: \tinput, err := json.Marshal(ChunkResponse{Chunks: chunks})\n120: \tif err != nil {\n121: \t\treturn nil, fmt.Errorf(\"reassemble-transcript: marshal: %w\", err)\n122: \t}\n123: \treturn e.run(context.Background(), input, \"reassemble-transcript\")\n124: }\n125: \n126: func (e *Agent) CompactTranscript(ctx context.Context, sessionRef string) (*agent.CompactedTranscript, error) {\n127: \tstdout, err := e.run(ctx, nil, \"compact-transcript\", \"--session-ref\", sessionRef)\n128: \tif err != nil {\n129: \t\treturn nil, fmt.Errorf(\"compact-transcript: %w\", err)\n130: \t}\n131: \n132: \tvar resp CompactTranscriptResponse\n133: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n134: \t\treturn nil, fmt.Errorf(\"compact-transcript: invalid JSON: %w\", err)\n135: \t}\n136: \n137: \tcompacted, err := resp.toCompactedTranscript()\n138: \tif err != nil {\n139: \t\treturn nil, err\n140: \t}\n141: \treturn compacted, nil\n142: }\n143: \n144: // --- Agent interface: Legacy methods ---\n145: \n146: func (e *Agent) GetSessionID(input *agent.HookInput) string {\n147: \tdata, err := marshalHookInput(input)\n148: \tif err != nil {\n149: \t\treturn \"\"\n150: \t}\n151: \tstdout, err := e.run(context.Background(), data, \"get-session-id\")\n152: \tif err != nil {\n153: \t\treturn \"\"\n154: \t}\n155: \tvar resp SessionIDResponse\n156: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n157: \t\treturn \"\"\n158: \t}\n159: \treturn resp.SessionID\n160: }\n161: \n162: func (e *Agent) GetSessionDir(repoPath string) (string, error) {\n163: \tstdout, err := e.run(context.Background(), nil, \"get-session-dir\", \"--repo-path\", repoPath)\n164: \tif err != nil {\n165: \t\treturn \"\", fmt.Errorf(\"get-session-dir: %w\", err)\n166: \t}\n167: \tvar resp SessionDirResponse\n168: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n169: \t\treturn \"\", fmt.Errorf(\"get-session-dir: invalid JSON: %w\", err)\n170: \t}\n171: \treturn resp.SessionDir, nil\n172: }\n173: \n174: func (e *Agent) ResolveSessionFile(sessionDir, agentSessionID string) string {\n175: \tstdout, err := e.run(context.Background(), nil, \"resolve-session-file\",\n176: \t\t\"--session-dir\", sessionDir, \"--session-id\", agentSessionID)\n177: \tif err != nil {\n178: \t\treturn \"\"\n179: \t}\n180: \tvar resp SessionFileResponse\n181: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n182: \t\treturn \"\"\n183: \t}\n184: \treturn resp.SessionFile\n185: }\n186: \n187: func (e *Agent) ReadSession(input *agent.HookInput) (*agent.AgentSession, error) {\n188: \tdata, err := marshalHookInput(input)\n189: \tif err != nil {\n190: \t\treturn nil, fmt.Errorf(\"read-session: marshal: %w\", err)\n191: \t}\n192: \tstdout, err := e.run(context.Background(), data, \"read-session\")\n193: \tif err != nil {\n194: \t\treturn nil, fmt.Errorf(\"read-session: %w\", err)\n195: \t}\n196: \tvar resp AgentSessionJSON\n197: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n198: \t\treturn nil, fmt.Errorf(\"read-session: invalid JSON: %w\", err)\n199: \t}\n200: \treturn unmarshalAgentSession(&resp)\n201: }\n202: \n203: func (e *Agent) WriteSession(ctx context.Context, session *agent.AgentSession) error {\n204: \tdata, err := marshalAgentSession(session)\n205: \tif err != nil {\n206: \t\treturn fmt.Errorf(\"write-session: marshal: %w\", err)\n207: \t}\n208: \t_, err = e.run(ctx, data, \"write-session\")\n209: \tif err != nil {\n210: \t\treturn fmt.Errorf(\"write-session: %w\", err)\n211: \t}\n212: \treturn nil\n213: }\n214: \n215: func (e *Agent) FormatResumeCommand(sessionID string) string {\n216: \tstdout, err := e.run(context.Background(), nil, \"format-resume-command\", \"--session-id\", sessionID)\n217: \tif err != nil {\n218: \t\treturn \"\"\n219: \t}\n220: \tvar resp ResumeCommandResponse\n221: \tif err := json.Unmarshal(stdout, &resp); err != nil {\n222: \t\treturn \"\"\n223: \t}\n224: \treturn resp.Command\n225: }\n226: \n227: // --- HookSupport methods (delegated when capabilities.hooks is true) ---\n228: \n229: func (e *Agent) HookNames() []string {\n230: \treturn e.info.HookNames\n231: }\n232: \n233: func (e *Agent) ParseHookEvent(ctx context.Context, hookName string, stdin io.Reader) (*agent.Event, error) {\n234: \tconst maxParseHookBytes = 10 * 1024 * 1024 // 10 MB\n235: \t// Stream a single (size-bounded) JSON value rather than io.ReadAll, so the\n236: \t// hook never blocks waiting for stdin EOF that some agents don't send on\n237: \t// Windows/Git Bash (issue #1398). The external \"parse-hook\" contract receives\n238: \t// the host's hook payload — which is JSON — and we forward its raw bytes\n239: \t// verbatim to the subprocess, so a plain byte copy is preserved.\n240: \traw, err := agent.ReadHookInputRawLimited(stdin, maxParseHookBytes)\n241: \tif err != nil {\n242: \t\treturn nil, fmt.Errorf(\"parse-hook: read stdin: %w\", err)\n243: \t}\n244: \tstdout, err := e.run(ctx, raw, \"parse-hook\", \"--hook\", hookName)\n245: \tif err != nil {\n246: \t\treturn nil, fmt.Errorf(\"parse-hook: %w\", err)\n247: \t}\n248: \t// null means no lifecycle significance\n249: \tif bytes.Equal(bytes.TrimSpace(stdout), []byte(\"null\")) {\n250: \t\treturn nil, nil //nolint:nilnil // protocol contract: null = no event\n251: \t}\n252: \tvar event eventJSON\n253: \tif err := json.Unmarshal(stdout, &event); err != nil {\n254: \t\treturn nil, fmt.Errorf(\"parse-hook: invalid JSON: %w\", err)\n255: \t}\n256: \treturn event.toEvent()\n257: }\n258: \n259: func (e *Agent) InstallHooks(ctx context.Context, localDev bool, force bool) (int, error) {\n260: \targs := []string{\"install-hooks\"}\n261: \tif localDev {\n262: \t\targs = append(args, \"--local-dev\")\n263: \t}\n264: \tif force {\n265: \t\targs = append(args, \"--force\")\n266: \t}\n267: \tstdout, err := e.run(ctx, nil, args...)\n268: