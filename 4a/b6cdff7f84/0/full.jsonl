hook command structure (e.g., \"entire hooks claude-code ...\")\n43: // rather than guessing from directory presence.\n44: // Falls back to GetAgent() if not in a hook context.\n45: func GetCurrentHookAgent() (agent.Agent, error) {\n46: \tif currentHookAgentName == \"\" {\n47: \t\treturn nil, errors.New(\"not in a hook context: agent name not set\")\n48: \t}\n49: \n50: \tag, err := agent.Get(currentHookAgentName)\n51: \tif err != nil {\n52: \t\treturn nil, fmt.Errorf(\"getting hook agent %q: %w\", currentHookAgentName, err)\n53: \t}\n54: \treturn ag, nil\n55: }\n56: \n57: // newAgentHooksCmd creates a hooks subcommand for an agent that implements HookSupport.\n58: // It dynamically creates subcommands for each hook the agent supports.\n59: func newAgentHooksCmd(agentName types.AgentName, handler agent.HookSupport) *cobra.Command {\n60: \tcmd := &cobra.Command{\n61: \t\tUse:    string(agentName),\n62: \t\tShort:  handler.Description() + \" hook handlers\",\n63: \t\tHidden: true,\n64: \t\tPersistentPreRunE: func(cmd *cobra.Command, _ []string) error {\n65: \t\t\tagentHookLogCleanup = initHookLogging(cmd.Context())\n66: \t\t\treturn nil\n67: \t\t},\n68: \t\tPersistentPostRunE: func(_ *cobra.Command, _ []string) error {\n69: \t\t\tif agentHookLogCleanup != nil {\n70: \t\t\t\tagentHookLogCleanup()\n71: \t\t\t}\n72: \t\t\treturn nil\n73: \t\t},\n74: \t}\n75: \n76: \tfor _, hookName := range handler.HookNames() {\n77: \t\tcmd.AddCommand(newAgentHookVerbCmdWithLogging(agentName, hookName))\n78: \t}\n79: \n80: \treturn cmd\n81: }\n82: \n83: // getHookType returns the hook type based on the hook name.\n84: // Returns \"subagent\" for task-related hooks (pre-task, post-task, post-todo),\n85: // \"tool\" for tool-related hooks (before-tool, after-tool),\n86: // \"agent\" for all other agent hooks.\n87: func getHookType(hookName string) string {\n88: \tswitch hookName {\n89: \tcase claudecode.HookNamePreTask, claudecode.HookNamePostTask, claudecode.HookNamePostTodo:\n90: \t\treturn \"subagent\"\n91: \tcase geminicli.HookNameBeforeTool, geminicli.HookNameAfterTool:\n92: \t\treturn \"tool\"\n93: \tdefault:\n94: \t\treturn \"agent\"\n95: \t}\n96: }\n97: \n98: // executeAgentHook runs the core hook execution logic for a given agent and hook name.\n99: // It handles git repo checks, enabled checks, logging, event parsing, and lifecycle dispatch.\n100: // Used by both the registered subcommand path and the RunE fallback for external agents.\n101: // When initLogging is true, it initializes and cleans up hook logging (used by the RunE fallback\n102: // since it doesn't go through PersistentPreRunE). Built-in agent subcommands pass false since\n103: // their parent command's PersistentPreRunE already handles logging.\n104: func executeAgentHook(cmd *cobra.Command, agentName types.AgentName, hookName string, initLogging bool) error {\n105: \t// Skip silently if not in a git repository - hooks shouldn't prevent the agent from working\n106: \tworktreeRoot, err := paths.WorktreeRoot(cmd.Context())\n107: \tif err != nil {\n108: \t\treturn nil\n109: \t}\n110: \n111: \t// Skip if Entire is not set up and enabled. This must fail closed: any\n112: \t// settings read error (missing file, corrupted JSON, transient I/O\n113: \t// failure) is treated as disabled so a hook never silently falls through\n114: \t// to full lifecycle work just because settings couldn't be read. Using\n115: \t// IsEnabled here previously failed OPEN on error (`err == nil && !enabled`\n116: \t// only short-circuits when the read succeeded), which meant a corrupted\n117: \t// or unreadable settings file made every hook invocation pay the full\n118: \t// dispatch cost instead of exiting fast (#524).\n119: \t// settings.IsSetUpAndEnabled is the same fail-closed gate the git hooks\n120: \t// use (see PersistentPreRunE in hooks_git_cmd.go).\n121: \tif !settings.IsSetUpAndEnabled(cmd.Context()) {\n122: \t\treturn nil\n123: \t}\n124: \n125: \tif initLogging {\n126: \t\tcleanup := initHookLogging(cmd.Context())\n127: \t\tdefer cleanup()\n128: \t}\n129: \n130: \t// Initialize logging context with agent name\n\n(Showing lines 1-130 of 372. Use offset=131 to continue.)\n</content>",
