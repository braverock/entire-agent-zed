            "output": "<path>/tmp/opencode/entireio-cli/cmd/entire/cli/hook_registry.go</path>\n<type>file</type>\n<content>\n1: // hook_registry.go provides hook command registration for agents.\n2: // The lifecycle dispatcher (DispatchLifecycleEvent) handles all lifecycle events.\n3: // PostTodo is the only hook that's handled directly (not via lifecycle dispatcher).\n4: package cli\n5: \n6: import (\n7: \t\"context\"\n8: \t\"errors\"\n9: \t\"fmt\"\n10: \t\"io\"\n11: \t\"log/slog\"\n12: \t\"strings\"\n13: \n14: \t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n15: \t\"github.com/entireio/cli/cmd/entire/cli/agent/claudecode\"\n16: \t\"github.com/entireio/cli/cmd/entire/cli/agent/geminicli\"\n17: \t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n18: \t\"github.com/entireio/cli/cmd/entire/cli/checkpointpolicy\"\n19: \t\"github.com/entireio/cli/cmd/entire/cli/gitrepo\"\n20: \t\"github.com/entireio/cli/cmd/entire/cli/logging\"\n21: \t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n22: \t\"github.com/entireio/cli/cmd/entire/cli/settings\"\n23: \t\"github.com/entireio/cli/cmd/entire/cli/strategy\"\n24: \t\"github.com/entireio/cli/cmd/entire/cli/telemetry\"\n25: \t\"github.com/entireio/cli/cmd/entire/cli/versioncheck\"\n26: \t\"github.com/entireio/cli/cmd/entire/cli/versioninfo\"\n27: \t\"github.com/entireio/cli/perf\"\n28: \n29: \t\"github.com/spf13/cobra\"\n30: )\n31: \n32: // agentHookLogCleanup stores the cleanup function for agent hook logging.\n33: // Set by PersistentPreRunE, called by PersistentPostRunE.\n34: var agentHookLogCleanup func()\n35: \n36: // currentHookAgentName stores the agent name for the currently executing hook.\n37: // Set by newAgentHookVerbCmdWithLogging before calling the handler.\n38: // This allows handlers to know which agent invoked the hook without guessing.\n39: var currentHookAgentName types.AgentName\n40: \n41: // GetCurrentHookAgent returns the agent for the currently executing hook.\n42: // Returns the agent based on the hook command structure (e.g., \"entire hooks claude-code ...\")\n43: // rather than guessing from directory presence.\n44: // Falls back to GetAgent() if not in a hook context.\n45: func GetCurrentHookAgent() (agent.Agent, error) {\n46: \tif currentHookAgentName == \"\" {\n47: \t\treturn nil, errors.New(\"not in a hook context: agent name not set\")\n48: \t}\n49: \n50: \tag, err := agent.Get(currentHookAgentName)\n51: \tif err != nil {\n52: \t\treturn nil, fmt.Errorf(\"getting hook agent %q: %w\", currentHookAgentName, err)\n53: \t}\n54: \treturn ag, nil\n55: }\n56: \n57: // newAgentHooksCmd creates a hooks subcommand for an agent that implements HookSupport.\n58: // It dynamically creates subcommands for each hook the agent supports.\n59: func newAgentHooksCmd(agentName types.AgentName, handler agent.HookSupport) *cobra.Command {\n60: \tcmd := &cobra.Command{\n61: \t\tUse:    string(agentName),\n62: \t\tShort:  handler.Description() + \" hook handlers\",\n63: \t\tHidden: true,\n64: \t\tPersistentPreRunE: func(cmd *cobra.Command, _ []string) error {\n65: \t\t\tagentHookLogCleanup = initHookLogging(cmd.Context())\n66: \t\t\treturn nil\n67: \t\t},\n68: \t\tPersistentPostRunE: func(_ *cobra.Command, _ []string) error {\n69: \t\t\tif agentHookLogCleanup != nil {\n70: \t\t\t\tagentHookLogCleanup()\n71: \t\t\t}\n72: \t\t\treturn nil\n73: \t\t},\n74: \t}\n75: \n76: \tfor _, hookName := range handler.HookNames() {\n77: \t\tcmd.AddCommand(newAgentHookVerbCmdWithLogging(agentName, hookName))\n78: \t}\n79: \n80: \treturn cmd\n81: }\n82: \n83: // getHookType returns the hook type based on the hook name.\n84: // Returns \"subagent\" for task-related hooks (pre-task, post-task, post-todo),\n85: // \"tool\" for tool-related hooks (before-tool, after-tool),\n86: // \"agent\" for all other agent hooks.\n87: func getHookType(hookName string) string {\n88: \tswitch hookName {\n89: \tcase claudecode.HookNamePreTask, claudecode.HookNamePostTask, claudecode.HookNamePostTodo:\n90: \t\treturn \"subagent\"\n91: \tcase geminicli.HookNameBeforeTool, geminicli.HookNameAfterTool:\n92: \t\treturn \"tool\"\n93: \tdefault:\n94: \t\treturn \"agent\"\n95: \t}\n96: }\n97: \n98: // executeAgentHook runs the core hook execution logic for a given agent and hook name.\n99: // It handles git repo checks, enabled checks, logging, event parsing, and lifecycle dispatch.\n100: // Used by both the registered subcommand path and the RunE fallback for external agents.\n101: // When initLogging is true, it initializes and cleans up hook logging (used by the RunE fallback\n102: // since it doesn't go through PersistentPreRunE). Built-in agent subcommands pass false since\n103: // their parent command's PersistentPreRunE already handles logging.\n104: func executeAgentHook(cmd *cobra.Command, agentName types.AgentName, hookName string, initLogging bool) error {\n105: \t// Skip silently if not in a git repository - hooks shouldn't prevent the agent from working\n106: \tworktreeRoot, err := paths.WorktreeRoot(cmd.Context())\n107: \tif err != nil {\n108: \t\treturn nil\n109: \t}\n110: \n111: \t// Skip if Entire is not set up and enabled. This must fail closed: any\n112: \t// settings read error (missing file, corrupted JSON, transient I/O\n113: \t// failure) is treated as disabled so a hook never silently falls through\n114: \t// to full lifecycle work just because settings couldn't be read. Using\n115: \t// IsEnabled here previously failed OPEN on error (`err == nil && !enabled`\n116: \t// only short-circuits when the read succeeded), which meant a corrupted\n117: \t// or unreadable settings file made every hook invocation pay the full\n118: \t// dispatch cost instead of exiting fast (#524).\n119: \t// settings.IsSetUpAndEnabled is the same fail-closed gate the git hooks\n120: \t// use (see PersistentPreRunE in hooks_git_cmd.go).\n121: \tif !settings.IsSetUpAndEnabled(cmd.Context()) {\n122: \t\treturn nil\n123: \t}\n124: \n125: \tif initLogging {\n126: \t\tcleanup := initHookLogging(cmd.Context())\n127: \t\tdefer cleanup()\n128: \t}\n129: \n130: \t// Initialize logging context with agent name\n131: \tctx := logging.WithAgent(logging.WithComponent(cmd.Context(), \"hooks\"), agentName)\n132: \n133: \t// Strategy name for logging\n134: \tstrategyName := strategy.StrategyNameManualCommit\n135: \n136: \thookType := getHookType(hookName)\n137: \n138: \t// Start root perf span — child spans in lifecycle handlers and strategy\n139: \t// methods will automatically nest under this span.\n140: \tctx, span := perf.Start(ctx, hookName,\n141: \t\tslog.String(\"hook_type\", hookType))\n142: \tdefer span.End()\n143: \n144: \tlogging.Debug(ctx, \"hook invoked\",\n145: \t\tslog.String(\"hook\", hookName),\n146: \t\tslog.String(\"hook_type\", hookType),\n147: \t\tslog.String(\"strategy\", strategyName),\n148: \t)\n149: \n150: \t// Set the current hook agent so handlers can retrieve it\n151: \tcurrentHookAgentName = agentName\n152: \tdefer func() { currentHookAgentName = \"\" }()\n153: \n154: \t// Use the lifecycle dispatcher for all hooks\n155: \tvar hookErr error\n156: \tag, agentErr := agent.Get(agentName)\n157: \tif agentErr != nil {\n158: \t\treturn fmt.Errorf(\"failed to get agent %q: %w\", agentName, agentErr)\n159: \t}\n160: \n161: \thandler, ok := agent.AsHookSupport(ag)\n162: \tif !ok {\n163: \t\treturn fmt.Errorf(\"agent %q does not support hooks\", agentName)\n164: \t}\n165: \n166: \t// Use cmd.InOrStdin() to support testing with cmd.SetIn()\n167: \tevent, parseErr := handler.ParseHookEvent(ctx, hookName, cmd.InOrStdin())\n168: \tif parseErr != nil {\n169: \t\treturn fmt.Errorf(\"failed to parse hook event: %w\", parseErr)\n170: \t}\n171: \n172: \tclaudePostTodoCheckpointHook := event == nil && agentName == agent.AgentNameClaudeCode && hookName == claudecode.HookNamePostTodo\n173: \teventType := agent.EventType(0)\n174: \n175: \tif event != nil {\n176: \t\t// Cross-agent guard: when Cursor IDE invokes a hook configured under\n177: \t\t// .claude/settings.json (because .cursor/hooks.json is missing), the\n178: \t\t// hook payload's transcript_path proves the session belongs to Cursor.\n179: \t\t// Skip dispatch so the session isn't claimed for the wrong agent (#1262).\n180: \t\tif shouldSkipForwardedHook(ctx, ag, event) {\n181: \t\t\tlogging.Debug(ctx, \"skipping forwarded hook: transcript belongs to another agent\",\n182: \t\t\t\tslog.String(\"hook\", hookName),\n183: \t\t\t\tslog.String(\"firing_agent\", string(agentName)),\n184: \t\t\t\tslog.String(\"session_ref\", event.SessionRef),\n185: \t\t\t)\n186: \t\t\treturn nil\n187: \t\t}\n188: \t\teventType = event.Type\n189: \t}\n190: \n191: \tif eventType == agent.SessionStart {\n192: \t\tskipSessionStart, err := shouldSkipSessionStartForPolicy(ctx, cmd.ErrOrStderr(), agentName, ag, worktreeRoot)\n193: \t\tif err != nil {\n194: \t\t\tspan.RecordError(err)\n195: \t\t\treturn err\n196: \t\t}\n197: \t\tif skipSessionStart {\n198: \t\t\treturn nil\n199: \t\t}\n200: \t} else if hookWritesCheckpointData(eventType, claudePostTodoCheckpointHook) {\n201: \t\twriteHook := agentWriteHookLabel(eventType, claudePostTodoCheckpointHook)\n202: \t\tif err := rejectUnsupportedCheckpointWritePolicy(ctx, cmd.ErrOrStderr(), agentName, writeHook, worktreeRoot); err != nil {\n203: \t\t\tspan.RecordError(err)\n204: \t\t\treturn err\n205: \t\t}\n206: \t}\n207: \n208: \tif event != nil {\n209: \t\t// Lifecycle event — use the generic dispatcher\n210: \t\thookErr = DispatchLifecycleEvent(ctx, ag, event)\n211: \t} else if claudePostTodoCheckpointHook {\n212: \t\t// PostTodo is Claude-specific: creates incremental checkpoints during subagent execution\n213: \t\thookErr = handleClaudeCodePostTodo(ctx)\n214: \t}\n215: \t// Other pass-through hooks (nil event, no special handling) are no-ops\n216: \n217: \tspan.RecordError(hookErr)\n218: \treturn hookErr\n219: }\n220: \n221: func agentHookPolicy(ctx context.Context, worktreeRoot string) (checkpointpolicy.Policy, error) {\n222: \trepo, err := gitrepo.OpenPath(worktreeRoot)\n223: \tif err != nil {\n224: \t\treturn checkpointpolicy.Policy{}, unreadableCheckpointPolicyError(err)\n225: \t}\n226: \tdefer repo.Close()\n227: \n228: \treturn checkpointPolicyForCheckpointData(ctx, repo)\n229: }\n230: \n231: func shouldSkipAgentHookForPolicy(policy checkpointpolicy.Policy) bool {\n232: \treturn !checkpointpolicy.CanSatisfyPolicy(policy)\n233: }\n234: \n235: func shouldSkipSessionStartForPolicy(ctx context.Context, errW io.Writer, agentName types.AgentName, ag agent.Agent, worktreeRoot string) (bool, error) {\n236: \tpolicy, err := agentHookPolicy(ctx, worktreeRoot)\n237: \tif err != nil {\n238: \t\tlogging.Warn(ctx, \"checkpoint policy read failed for agent hook\",\n239: \t\t\tslog.String(\"error\", err.Error()))\n240: \t\temitCheckpointPolicyBlocked(ctx, telemetry.CheckpointPolicyBlockedEvent{\n241: \t\t\tHook:     \"session-start\",\n242: \t\t\tHookType: telemetry.PolicyBlockedHookTypeAgent,\n243: \t\t\tReason:   telemetry.PolicyBlockedReasonUnreadable,\n244: \t\t\tOutcome:  telemetry.PolicyBlockedOutcomeSkipped,\n245: \t\t\tAgent:    string(agentName),\n246: \t\t})\n247: \t\t// Let the agent start; the warning explains that checkpoint capture is\n248: \t\t// disabled until the policy can be read.\n249: \t\treturn true, writeUnsupportedPolicySessionStartWarning(errW, ag, sessionStartPolicyReadErrorWarning(err))\n250: \t}\n251: \tif shouldSkipAgentHookForPolicy(policy) {\n252: \t\temitCheckpointPolicyBlocked(ctx, telemetry.CheckpointPolicyBlockedEvent{\n253: \t\t\tHook:                 \"session-start\",\n254: \t\t\tHookType:             telemetry.PolicyBlockedHookTypeAgent,\n255: \t\t\tReason:               telemetry.PolicyBlockedReasonUnsupported,\n256: \t\t\tOutcome:              telemetry.PolicyBlockedOutcomeSkipped,\n257: \t\t\tAgent:                string(agentName),\n258: \t\t\tCheckpointVersion:    policy.CheckpointVersion,\n259: \t\t\tCheckpointMinVersion: policy.CheckpointMinVersion,\n260: \t\t})\n261: \t\t// Let the agent start; the warning explains that checkpoint capture is\n262: \t\t// disabled until the CLI is upgraded.\n263: \t\treturn true, writeUnsupportedPolicySessionStartWarning(errW, ag, sessionStartPolicyWarning(policy))\n264: \t}\n265: \treturn false, nil\n266: }\n267: \n268: func rejectUnsupportedCheckpointWritePolicy(ctx context.Context, errW io.Writer, agentName types.AgentName, hook string, worktreeRoot string) error {\n269: \tpolicy, err := agentHookPolicy(ctx, worktreeRoot)\n270: \tif err != nil {\n271: \t\tlogging.Warn(ctx, \"checkpoint policy read failed for agent hook\",\n272: \t\t\tslog.String(\"error\", err.Error()))\n273: \t\temitCheckpointPolicyBlocked(ctx, telemetry.CheckpointPolicyBlockedEvent{\n274: \t\t\tHook:     hook,\n275: \t\t\tHookType: telemetry.PolicyBlockedHookTypeAgent,\n276: \t\t\tReason:   telemetry.PolicyBlockedReasonUnreadable,\n277: \t\t\tOutcome:  telemetry.PolicyBlockedOutcomeBlocked,\n278: \t\t\tAgent:    string(agentName),\n279: \t\t})\n280: \t\tfmt.Fprint(errW, agentCheckpointCaptureDisabledReadErrorMessage(err))\n281: \t\treturn NewSilentError(err)\n282: \t}\n283: \tif shouldSkipAgentHookForPolicy(policy) {\n284: \t\temitCheckpointPolicyBlocked(ctx, telemetry.CheckpointPolicyBlockedEvent{\n285: \t\t\tHook:                 hook,\n286: \t\t\tHookType:             telemetry.PolicyBlockedHookTypeAgent,\n287: \t\t\tReason:               telemetry.PolicyBlockedReasonUnsupported,\n288: \t\t\tOutcome:              telemetry.PolicyBlockedOutcomeBlocked,\n289: \t\t\tAgent:                string(agentName),\n290: \t\t\tCheckpointVersion:    policy.CheckpointVersion,\n291: \t\t\tCheckpointMinVersion: policy.CheckpointMinVersion,\n292: \t\t})\n293: \t\tfmt.Fprint(errW, agentCheckpointCaptureDisabledMessage(policy))\n294: \t\treturn NewSilentError(errUnsupportedCheckpointPolicy)\n295: \t}\n296: \treturn nil\n297: }\n298: \n299: func hookWritesCheckpointData(eventType agent.EventType, claudePostTodoCheckpointHook bool) bool {\n300: \tif claudePostTodoCheckpointHook {\n301: \t\treturn true\n302: \t}\n303: \treturn eventType == agent.TurnEnd || eventType == agent.SubagentEnd\n304: }\n305: \n306: func agentWriteHookLabel(eventType agent.EventType, claudePostTodoCheckpointHook bool) string {\n307: \tswitch {\n308: \tcase claudePostTodoCheckpointHook:\n309: \t\treturn \"post-todo\"\n310: \tcase eventType == agent.SubagentEnd:\n311: \t\treturn \"subagent-end\"\n312: \tdefault:\n313: \t\treturn \"turn-end\"\n314: \t}\n315: }\n316: \n317: func sessionStartPolicyWarning(policy checkpointpolicy.Policy) string {\n318: \tmessage := \"Entire CLI is enabled, but this repository's checkpoint policy requires a newer Entire CLI. No Entire checkpoints will be created for this session until you upgrade.\"\n319: \tdetails := strings.TrimSpace(checkpointpolicy.UnsupportedPolicyMessage(policy, versioncheck.UpdateCommandForCurrentBinary(versioninfo.Version)))\n320: \tif details == \"\" {\n321: \t\treturn message\n322: \t}\n323: \treturn message + \"\\n\\n\" + details\n324: }\n325: \n326: func sessionStartPolicyReadErrorWarning(err error) string {\n327: \treturn fmt.Sprintf(\"Entire CLI is enabled, but this repository's checkpoint policy could not be read. No Entire checkpoints will be created for this session until the policy can be read.\\n\\n[entire] Details:\\n[entire]   %v\", err)\n328: }\n329: \n330: func agentCheckpointCaptureDisabledMessage(policy checkpointpolicy.Policy) string {\n331: \tvar b strings.Builder\n332: \tb.WriteString(\"[entire] Checkpoint capture is disabled for this repository.\\n\")\n333: \tb.WriteString(\"[entire] No Entire checkpoints will be created until the CLI is upgraded.\\n\")\n334: \tif details := strings.TrimSpace(checkpointpolicy.UnsupportedPolicyMessage(policy, versioncheck.UpdateCommandForCurrentBinary(versioninfo.Version))); details != \"\" {\n335: \t\tb.WriteString(details)\n336: \t\tb.WriteByte('\\n')\n337: \t}\n338: \treturn b.String()\n339: }\n340: \n341: func agentCheckpointCaptureDisabledReadErrorMessage(err error) string {\n342: \tvar b strings.Builder\n343: \tb.WriteString(\"[entire] Checkpoint capture is disabled for this repository.\\n\")\n344: \tb.WriteString(\"[entire] No Entire checkpoints will be created until the checkpoint policy can be read.\\n\")\n345: \tfmt.Fprintf(&b, \"[entire] Details:\\n[entire]   %v\\n\", err)\n346: \treturn b.String()\n347: }\n348: \n349: func writeUnsupportedPolicySessionStartWarning(errW io.Writer, ag agent.Agent, message string) error {\n350: \tif writer, ok := agent.AsHookResponseWriter(ag); ok {\n351: \t\tif err := writer.WriteHookResponse(message); err != nil {\n352: \t\t\treturn fmt.Errorf(\"failed to write hook response: %w\", err)\n353: \t\t}\n354: \t\treturn nil\n355: \t}\n356: \tfmt.Fprintln(errW, message)\n357: \treturn nil\n358: }\n359: \n360: // newAgentHookVerbCmdWithLogging creates a command for a specific hook verb with structured logging.\n361: // It uses the lifecycle dispatcher (ParseHookEvent → DispatchLifecycleEvent) as the primary path.\n362: // PostTodo is handled directly as it's Claude-specific and not part of the lifecycle dispatcher.\n363: func newAgentHookVerbCmdWithLogging(agentName types.AgentName, hookName string) *cobra.Command {\n364: \treturn &cobra.Command{\n365: \t\tUse:    hookName,\n366: \t\tHidden: true,\n367: \t\tShort:  \"Called on \" + hookName,\n368: \t\tRunE: func(cmd *cobra.Command, _ []string) error {\n369: \t\t\treturn executeAgentHook(cmd, agentName, hookName, false)\n370: \t\t},\n371: \t}\n372: }\n\n(End of file - total 372 lines)\n</content>",
